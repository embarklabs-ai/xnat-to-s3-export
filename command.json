{
  "name": "xnat2s3",
  "label": "xnat2s3",
  "description": "Export Session Data as zipped DICOM scans from XNAT to an S3 bucket",
  "version": "1.0",
  "schema-version": "1.0",
  "image": "radiologicsremya/xnat2s3-zip:1.0",
  "type": "docker",
  "command-line": "python /usr/local/bin/run.py #BUCKETNAME# -p $PROJECT_ID -t $SUBJECT_LABEL -m $SESSION_LABEL",
  "override-entrypoint": true,
  "mounts": [
    {
      "name": "in",
      "writable": false,
      "path": "/input"
    }
  ],
  "environment-variables": {
    "SESSION_LABEL": "#SESSION_LABEL#",
    "SUBJECT_LABEL": "#SUBJECT_LABEL#",
    "PROJECT_ID": "#PROJECT_ID#"
  },
  "ports": {},
  "inputs": [
    {
      "name": "S3-bucket",
      "description": "AWS S3 Bucket",
      "type": "string",
      "default-value": "s3://bucket-name",
      "required": true,
      "replacement-key": "#BUCKETNAME#",
      "command-line-flag": "-b",
      "select-values": []
    },
    {
      "name": "project-id",
      "description": "XNAT Project ID",
      "type": "string",
      "required": true,
      "replacement-key": "#PROJECT_ID#",
      "select-values": []
    },
    {
      "name": "subject-label",
      "description": "XNAT Subject Label",
      "type": "string",
      "required": true,
      "replacement-key": "#SUBJECT_LABEL#",
      "select-values": []
    },
    {
      "name": "session-label",
      "description": "XNAT Session LABEL",
      "type": "string",
      "required": true,
      "replacement-key": "#SESSION_LABEL#",
      "select-values": []
    }
  ],
  "xnat": [
    {
      "name": "xnat2s3",
      "label": "xnat2s3",
      "description": "Export Session Data from XNAT to an S3 bucket",
      "contexts": [
        "xnat:imageSessionData"
      ],
      "external-inputs": [
        {
          "name": "session",
          "description": "Input session",
          "type": "Session",
          "required": true,
          "provides-files-for-command-mount": "in",
          "load-children": false
        }
      ],
      "derived-inputs": [
        {
          "name": "subject",
          "type": "Subject",
          "required": true,
          "user-settable": false,
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "multiple": false
        },
        {
          "name": "subject-label",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "subject-label",
          "load-children": true,
          "derived-from-wrapper-input": "subject",
          "derived-from-xnat-object-property": "label",
          "multiple": false
        },
        {
          "name": "project",
          "type": "Project",
          "required": true,
          "user-settable": false,
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "multiple": false
        },
        {
          "name": "project-id",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "project-id",
          "load-children": true,
          "derived-from-wrapper-input": "project",
          "derived-from-xnat-object-property": "id",
          "multiple": false
        },
        {
          "name": "session-label",
          "type": "string",
          "required": true,
          "provides-value-for-command-input": "session-label",
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "label",
          "multiple": false
        }
      ]
    }
  ],
  "reserve-memory": 1750,
  "limit-memory": 1750,
  "network": "host",
  "container-labels": {},
  "generic-resources": {},
  "ulimits": {}
}
